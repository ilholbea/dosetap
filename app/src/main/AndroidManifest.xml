<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== PERMISSIONS ===== -->
    <!-- Show time-sensitive notifications (runtime prompt on API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        SCHEDULE_EXACT_ALARM — the broadly-accepted permission for exact reminders (E-H3). On
        Android 12 it's auto-granted (revocable); on 13+ the user grants it via a just-in-time
        prompt (ACTION_REQUEST_SCHEDULE_EXACT_ALARM, surfaced as a Home banner). If unavailable,
        AlarmScheduler.setExact falls back to an inexact alarm rather than failing.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Reschedule alarms after device reboot (critical — system drops alarms on reboot) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Vibrate device when alarm fires -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wake the screen to show AlarmActivity over lock screen -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Full-screen alarm UI (AlarmActivity) over the lock screen. Without this, setFullScreenIntent
        silently degrades to a heads-up notification on targetSdk 34+ (E-H5). Play auto-grants it to
        alarm/calendar apps; complete the Play Console full-screen-intent declaration at submission.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- NOTE: No INTERNET permission. Enforced by CI lint check. All data is local. -->

    <application
        android:name=".DoseTapApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoseTap">

        <!-- Main entry point -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen alarm activity — shown over lock screen -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.DoseTap.Alarm"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <!-- Widget configuration activity — launched by launcher when user adds widget -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DoseTap">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Glance widget receiver -->
        <receiver
            android:name=".widget.DoseWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Alarm BroadcastReceiver — fires when AlarmManager triggers -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- Handles Taken/Snooze/Skip actions from notification buttons -->
        <receiver
            android:name=".alarm.DoseActionReceiver"
            android:exported="false" />

        <!-- Weekly adherence summary (Sunday 8pm) -->
        <receiver
            android:name=".alarm.WeeklySummaryReceiver"
            android:exported="false" />

        <!-- Handles "Log dose" action from the ambient persistent notification -->
        <receiver
            android:name=".alarm.AmbientLogDoseReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dosetap.action.AMBIENT_LOG_DOSE" />
            </intent-filter>
        </receiver>

        <!-- Handles wear-off warning alarm -->
        <receiver
            android:name=".alarm.WearOffWarningReceiver"
            android:exported="false" />

        <!-- Smart escalation: re-posts a reminder as a re-nudge if the user hasn't engaged -->
        <receiver
            android:name=".alarm.EscalationReceiver"
            android:exported="false" />

        <!-- Fires a notification when a Focus Timer session ends -->
        <receiver
            android:name=".alarm.FocusAlarmReceiver"
            android:exported="false" />

        <!--
            BootReceiver listens for all 4 system events that require alarm rescheduling:
            1. BOOT_COMPLETED — device rebooted (alarms are lost)
            2. MY_PACKAGE_REPLACED — app updated (alarms may be cleared)
            3. TIMEZONE_CHANGED — user traveled/changed TZ (absolute times still valid but show notification)
            4. TIME_SET — user manually changed clock (absolute times still valid)
        -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for sharing backup JSON files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
