<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for all activities. Compose renders its own UI; this just sets window chrome. -->
    <style name="Theme.DoseTap" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Alarm activity: full-screen, shows over lock screen. -->
    <style name="Theme.DoseTap.Alarm" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
