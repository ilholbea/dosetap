<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules (Android < 12).
  Privacy-first stance per PLAN.md Hard Rule 7: dose history and medication data
  never leave the phone. Users move data between devices via the in-app
  Settings → Export / Import JSON flow (GDPR Article 20 portability), which is
  explicit and user-controlled.

  data_extraction_rules.xml mirrors this for Android 12+.
-->
<full-backup-content>
    <!-- Exclude Room DB and journal files -->
    <exclude domain="database" path="dosetap_database" />
    <exclude domain="database" path="dosetap_database-shm" />
    <exclude domain="database" path="dosetap_database-wal" />
    <!-- Exclude DataStore preferences (contain selected med, dismissal flags) -->
    <exclude domain="file" path="datastore/dosetap_settings.preferences_pb" />
</full-backup-content>
