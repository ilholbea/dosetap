<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Room database for privacy — medication/dose history stays on-device only -->
        <exclude domain="database" path="dosetap_database" />
        <exclude domain="database" path="dosetap_database-shm" />
        <exclude domain="database" path="dosetap_database-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dosetap_database" />
        <exclude domain="database" path="dosetap_database-shm" />
        <exclude domain="database" path="dosetap_database-wal" />
    </device-transfer>
</data-extraction-rules>
