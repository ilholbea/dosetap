<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dosetap_database" />
        <exclude domain="database" path="dosetap_database-shm" />
        <exclude domain="database" path="dosetap_database-wal" />
        <!-- Exclude DataStore: contains billing/trial state — must not restore across installs -->
        <exclude domain="file" path="datastore/dosetap_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dosetap_database" />
        <exclude domain="database" path="dosetap_database-shm" />
        <exclude domain="database" path="dosetap_database-wal" />
        <exclude domain="file" path="datastore/dosetap_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
